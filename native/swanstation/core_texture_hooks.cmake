# Reproducible patch of a build COPY. The pinned upstream checkout is untouched.
function(swan_attach_texture_hooks)
  cmake_policy(SET CMP0079 NEW)
  set(input "${PROJECT_SOURCE_DIR}/src/core/texture_replacements.cpp")
  file(READ "${input}" text)
  set(directory_signature "std::string TextureReplacements::GetSourceDirectory() const\n{")
  set(write_signature "const TextureReplacementTexture* TextureReplacements::GetVRAMWriteReplacement(uint32_t width, uint32_t height, const void* pixels)\n{")
  set(load_signature "return LoadTexture(it->second);")
  foreach(signature IN ITEMS directory_signature write_signature load_signature)
    string(FIND "${text}" "${${signature}}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Pinned texture hook no longer matches: ${signature}")
    endif()
  endforeach()
  string(REPLACE "${directory_signature}" "${directory_signature}\n  const auto override_directory = swan_texture_directory(m_game_id);\n  if (!override_directory.empty()) return override_directory;" text "${text}")
  string(REPLACE "${write_signature}" "${write_signature}\n  swan_dump_vram(width, height, pixels);" text "${text}")
  string(REPLACE "return LoadTexture(it->second);" "const auto* replacement = LoadTexture(it->second);\n  if (replacement) swan_replacement_loaded();\n  return replacement;" text "${text}")
  string(PREPEND text "// Generated build copy; upstream GPL notices remain in the source checkout.\n#include <string>\n#include <cstdint>\nextern std::string swan_texture_directory(const std::string&);\nextern void swan_dump_vram(uint32_t, uint32_t, const void*);\nextern void swan_replacement_loaded();\n")
  set(output "${PROJECT_BINARY_DIR}/swan_texture_replacements.cpp")
  file(WRITE "${output}" "${text}")
  get_target_property(sources core SOURCES)
  list(REMOVE_ITEM sources texture_replacements.cpp)
  set_property(TARGET core PROPERTY SOURCES "${sources}")
  target_sources(core PRIVATE "${output}")
  target_include_directories(core PRIVATE "${PROJECT_SOURCE_DIR}/src/core")
  target_link_libraries(swanstation_libretro PRIVATE z)
  target_include_directories(swanstation_libretro PRIVATE "${PROJECT_SOURCE_DIR}/dep/xxhash/include")
endfunction()
