<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths for the in-app updater (github flavor only). The downloaded update APK
     lives in externalCacheDir/updates/ and is handed to the package installer from there.
     The cache dir is used deliberately: the OS can evict it, and each download wipes the
     directory first, so at most one ~N MB APK is ever parked on the device. -->
<paths>
    <external-cache-path name="updates" path="updates/" />
</paths>
